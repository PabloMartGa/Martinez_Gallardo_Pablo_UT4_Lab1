<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guiaCentro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5" />

    <!-- Columna izquierda -->
    <TextView
        android:id="@+id/tvTitulo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="8dp"
        android:text="@string/titulo"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tvDescripcion"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/guiaCentro"
        app:layout_constraintVertical_chainStyle="spread" />

    <TextView
        android:id="@+id/tvDescripcion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="8dp"
        android:text="@string/descripcion"
        app:layout_constraintTop_toBottomOf="@id/tvTitulo"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/guiaCentro" />

    <!-- Columna derecha -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clMapa"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/guiaCentro"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/ivAnillo"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="@string/cd_anillo"
            android:src="@android:drawable/ic_menu_compass"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ImageButton
            android:id="@+id/btnGondor"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@string/gondor"
            android:src="@android:drawable/ic_menu_mylocation"
            app:layout_constraintCircle="@id/ivAnillo"
            app:layout_constraintCircleRadius="95dp"
            app:layout_constraintCircleAngle="0"
            tools:ignore="MissingConstraints" />

        <ImageButton
            android:id="@+id/btnRohan"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@string/rohan"
            android:src="@android:drawable/ic_menu_myplaces"
            app:layout_constraintCircle="@id/ivAnillo"
            app:layout_constraintCircleRadius="95dp"
            app:layout_constraintCircleAngle="120"
            tools:ignore="MissingConstraints" />

        <ImageButton
            android:id="@+id/btnMordor"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@string/mordor"
            android:src="@android:drawable/ic_menu_view"
            app:layout_constraintCircle="@id/ivAnillo"
            app:layout_constraintCircleRadius="95dp"
            app:layout_constraintCircleAngle="240"
            tools:ignore="MissingConstraints" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>